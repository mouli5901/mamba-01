# ── LLM API Keys ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXX
OPENAI_API_KEY=sk-XXXX
GOOGLE_API_KEY=AIzaXXXX

# ── Zerodha Kite Connect ──────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# ── Database (TimescaleDB) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kite:kite@timescaledb:5432/kite
DATABASE_URL_SYNC=postgresql+psycopg2://kite:kite@timescaledb:5432/kite

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Trading mode ──────────────────────────────────────────────
# NEVER set to true unless you have explicitly confirmed via
# risk_manager.py's manual confirmation step.
LIVE_TRADING=false
